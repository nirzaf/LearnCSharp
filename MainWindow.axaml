<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LearnCSharp.MainWindow"
        Title="Note-Taking App" Width="600" Height="400">
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="2*,3*">
    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10">
      <TextBox x:Name="SearchBox" Width="300" Watermark="Search notes..." />
      <Button x:Name="SearchButton" Content="Search" Margin="10,0,0,0" />
      <Button x:Name="NewNoteButton" Content="New Note" Margin="10,0,0,0" />
      <Button x:Name="SaveNoteButton" Content="Save Note" Margin="10,0,0,0" />
    </StackPanel>
    <ListBox x:Name="NotesList" Grid.Row="1" Grid.Column="0" Margin="10" />
    <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="10">
      <TextBox x:Name="NoteContentBox" AcceptsReturn="True" />
    </ScrollViewer>
  </Grid>
</Window>

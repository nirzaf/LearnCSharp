<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LearnCSharp.MainWindow"
        Title="Note-Taking App" Width="800" Height="500">
  <Window.Styles>
    <!-- Light Theme Styles -->
    <Style Selector=":is(Window).Light">
      <Setter Property="Background" Value="#f5f5f7"/>
    </Style>
    <Style Selector="Border.card:is(Window).Light">
      <Setter Property="Background" Value="#ffffff"/>
      <Setter Property="Border.BoxShadow" Value="0 2 8 0 #00000022"/>
    </Style>
    <Style Selector="Border.toolbar:is(Window).Light">
      <Setter Property="Background" Value="#ffffff"/>
      <Setter Property="Border.BoxShadow" Value="0 1 3 0 #00000022"/>
    </Style>
    <Style Selector="Border.noteItem:is(Window).Light">
      <Setter Property="Background" Value="#f8f9fa"/>
    </Style>
    <Style Selector="TextBlock.secondary:is(Window).Light">
      <Setter Property="Foreground" Value="#555555"/>
    </Style>
    <Style Selector="TextBlock.tertiary:is(Window).Light">
      <Setter Property="Foreground" Value="#777777"/>
    </Style>
    
    <!-- Dark Theme Styles -->
    <Style Selector=":is(Window).Dark">
      <Setter Property="Background" Value="#202124"/>
    </Style>
    <Style Selector="Border.card:is(Window).Dark">
      <Setter Property="Background" Value="#2d2e31"/>
      <Setter Property="Border.BoxShadow" Value="0 2 8 0 #00000044"/>
    </Style>
    <Style Selector="Border.toolbar:is(Window).Dark">
      <Setter Property="Background" Value="#2d2e31"/>
      <Setter Property="Border.BoxShadow" Value="0 1 3 0 #00000044"/>
    </Style>
    <Style Selector="Border.noteItem:is(Window).Dark">
      <Setter Property="Background" Value="#35363a"/>
    </Style>
    <Style Selector="TextBlock:is(Window).Dark">
      <Setter Property="Foreground" Value="#e8eaed"/>
    </Style>
    <Style Selector="TextBlock.secondary:is(Window).Dark">
      <Setter Property="Foreground" Value="#bdc1c6"/>
    </Style>
    <Style Selector="TextBlock.tertiary:is(Window).Dark">
      <Setter Property="Foreground" Value="#9aa0a6"/>
    </Style>
    <Style Selector="TextBox:is(Window).Dark">
      <Setter Property="Background" Value="#35363a"/>
      <Setter Property="Foreground" Value="#e8eaed"/>
      <Setter Property="BorderBrush" Value="#5f6368"/>
    </Style>
    <Style Selector="ListBox:is(Window).Dark">
      <Setter Property="Background" Value="#2d2e31"/>
      <Setter Property="BorderBrush" Value="#5f6368"/>
    </Style>
    
    <!-- Common Styles -->
    <Style Selector="Button.toolbar">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Background" Value="#3498db"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.toolbar:pointerover">
      <Setter Property="Background" Value="#2980b9"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#ddd"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#ddd"/>
    </Style>
  </Window.Styles>
  
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="1.5*,3*" MinWidth="320" MinHeight="300">
    <!-- Toolbar -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="toolbar" Padding="12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox x:Name="SearchBox" Width="240" Watermark="Search notes..." />
        <Button x:Name="NewNoteButton" Classes="toolbar" ToolTip.Tip="New Note" Background="#27ae60">
          <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="18" Height="18" Foreground="White"/>
        </Button>
        <Button x:Name="SaveNoteButton" Classes="toolbar" ToolTip.Tip="Save">
          <PathIcon Data="M17 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm0 2v4H7V5h10zm-5 10a2 2 0 1 1 0-4 2 2 0 0 1 0 4z" Width="18" Height="18" Foreground="White"/>
        </Button>
        <Button x:Name="UpdateNoteButton" Classes="toolbar" ToolTip.Tip="Update">
          <PathIcon Data="M3 17.25V21h3.75l11.06-11.06-3.75-3.75L3 17.25zM20.71 7.04a1.003 1.003 0 0 0 0-1.42l-2.34-2.34a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z" Width="18" Height="18" Foreground="White"/>
        </Button>
        <Button x:Name="DeleteNoteButton" Classes="toolbar" ToolTip.Tip="Delete" Background="#e74c3c">
          <PathIcon Data="M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12zm3.46-7.12l1.42 1.42L12 13.42l1.12-1.12 1.42-1.42-1.42-1.42L12 10.58l-1.12-1.12-1.42 1.42zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="18" Height="18" Foreground="White"/>
        </Button>
        <Button x:Name="ThemeToggleButton" Classes="toolbar" ToolTip.Tip="Toggle Light/Dark Mode" Background="#9b59b6">
          <PathIcon Data="M12 4.354a1 1 0 0 1 1 0l2.121 1.228a1 1 0 0 0 1.415-.415l1.228-2.121a1 1 0 0 1 1.732 0l1.228 2.121a1 1 0 0 0 1.415.415l2.121-1.228a1 1 0 0 1 1 0l-1.228 2.121a1 1 0 0 0 .415 1.415l2.121 1.228a1 1 0 0 1 0 1l-2.121 1.228a1 1 0 0 0-.415 1.415l1.228 2.121a1 1 0 0 1 0 1.732l-2.121-1.228a1 1 0 0 0-1.415.415l-1.228 2.121a1 1 0 0 1-1.732 0l-1.228-2.121a1 1 0 0 0-1.415-.415l-2.121 1.228a1 1 0 0 1-1 0l2.121-1.228a1 1 0 0 0-.415-1.415l-2.121-1.228a1 1 0 0 1 0-1l2.121-1.228a1 1 0 0 0 .415-1.415L12 4.354z" Width="18" Height="18" Foreground="White"/>
        </Button>
        <TextBlock x:Name="AutosaveStatus" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#888" FontStyle="Italic" FontWeight="SemiBold"/>
      </StackPanel>
    </Border>
    
    <!-- Sidebar: Notes List with metadata -->
    <Border Grid.Row="1" Grid.Column="0" Margin="12,12,6,12" CornerRadius="8" Classes="card">
      <ListBox x:Name="NotesList" Padding="8" SelectionMode="Single">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Padding="10" Margin="0,4" CornerRadius="4" Classes="noteItem">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
                <TextBlock Text="{Binding UpdatedAt, StringFormat='Updated: {0:yyyy-MM-dd HH:mm}'}" FontSize="12" Classes="secondary" Margin="0,4,0,0" />
                <TextBlock Text="{Binding CreatedAt, StringFormat='Created: {0:yyyy-MM-dd HH:mm}'}" FontSize="10" Classes="tertiary" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    
    <!-- Main Editor -->
    <Border Grid.Row="1" Grid.Column="1" Margin="6,12,12,12" CornerRadius="8" Padding="16" Classes="card">
      <StackPanel>
        <TextBox x:Name="NoteTitleBox" FontWeight="Bold" FontSize="20" Margin="0,0,0,12" Watermark="Note Title..." />
        <TextBox x:Name="NoteContentBox" AcceptsReturn="True" FontSize="16" Height="320" Watermark="Type your note here..." TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
